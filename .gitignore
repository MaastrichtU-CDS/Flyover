.coverage
coverage.xml
htmlcov/
flyover/.coverage

# RDF store data and logs (generated at runtime, not tracked).
# Settings/config files under these directories are kept (only data and logs
# are ignored).
# GraphDB
graphdb/data/
stores/rdf/graphdb/data/
# RDF4J
stores/rdf/rdf4j/data/
stores/rdf/rdf4j/logs/
# QLever (on-disk index)
stores/rdf/qlever/data/
!stores/rdf/qlever/data/.gitkeep

# Test and demo files (but keep actual test suites)
test_annotation_ui.py
setup_test_data.py
annotation_ui_demo.html
# test_*.py in root directory - keep test suites in flyover/backend/data_descriptor/tests/
!/flyover/backend/data_descriptor/tests/test_*.py

