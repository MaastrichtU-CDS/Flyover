# Template that is automatically filled in using Python; the placeholders are substituted with values from the JSON file.

# Ensure that the necessary prefixes are included in the query as these are not automatically filled in.
PREFIX db: <http://data.local/rdf/ontology/>
PREFIX dbo: <http://um-cds/ontologies/databaseontology/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX roo: <http://www.cancerdata.org/roo/>
PREFIX ncit: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>
PREFIX PLACEHOLDER: <>

# Only the edges that exist are looked up, in the annotation graph they were
# written to, from the nodes of the class to the rows that have them. Asking
# for the table's rows and the class's nodes on their own, as two patterns
# that share nothing, has every store pair each row with each node first.
DELETE { GRAPH <http://annotation.local/databasename/> { ?tablerow dbo:has_column ?variable . } }

WHERE {
    GRAPH <http://annotation.local/databasename/> {
        ?variable rdf:type db:databasename.localvariable .
        ?tablerow dbo:has_column ?variable .
    }
    GRAPH ?dataGraph { ?tablerow rdf:type db:databasename . }
}
