# Coverage configuration for the backend test layers (pytest --cov).
# Lives next to the code it measures; from the repo root pass
# --cov-config=app/backend/data_descriptor/.coveragerc, as the CI workflow does.
#
# The test modules themselves and the gunicorn entrypoint are left out of
# the denominator: data_descriptor_main.py monkey-patches gevent at import
# time, so it is only imported in a separate process (test_api_factory.py)
# or by the Docker e2e layer; the app it builds comes from app_factory.py,
# which is measured.
[run]
omit =
    */data_descriptor/tests/*
    */data_descriptor/data_descriptor_main.py
    */backend/scripts/*

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    if __name__ == .__main__.:
